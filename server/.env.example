# ─── Server Environment Configuration ─────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Connection ───────────────────────────────────────────────────────
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/dress_catalog
# Hostinger / Production (MongoDB Atlas connection string):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dress_catalog?retryWrites=true&w=majority

# ─── Authentication (JWT) ─────────────────────────────────────────────────────
# Minimum 32-character random string for signing JWT tokens
JWT_SECRET=luxe_drape_super_secret_jwt_key_change_in_production_min32chars!
JWT_EXPIRES_IN=7d

# ─── Client / CORS Configuration ──────────────────────────────────────────────
# Local frontend:
CLIENT_URL=http://localhost:5173
# Hostinger production domain:
# CLIENT_URL=https://yourdomain.com
